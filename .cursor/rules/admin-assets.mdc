		stepsCount, viewSteps, hideSteps, checklistSteps, stepSettings,
		roleTargetMapping, roleTargetMappingHelp, allRoles, rolesSelected,
		deepLinkHelp, deepLinkAuto, stepTypeHelp, showNoteField, showNoteFieldHelp, showScreenshotField, showScreenshotFieldHelp,
		connected, notDetected, setup,
		pushChecklist, pushChecklistSelect, pushChecklistNeed, pushChecklistStarted, pushChecklistBlocked,
		clientPanelBadge, clientPushOk, clientPushSkipped, clientPushFailed,
		editSite, testSite, siteActionsMenu,
